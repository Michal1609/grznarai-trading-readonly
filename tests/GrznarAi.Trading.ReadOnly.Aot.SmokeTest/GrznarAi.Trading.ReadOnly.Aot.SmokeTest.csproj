<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>GrznarAi.Trading.ReadOnly.Aot.SmokeTest</AssemblyName>
    <RootNamespace>GrznarAi.Trading.ReadOnly.Aot.SmokeTest</RootNamespace>
    <IsPackable>false</IsPackable>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <StripSymbols>true</StripSymbols>
    <WarningsAsErrors>$(WarningsAsErrors);IL2026;IL3050</WarningsAsErrors>
    <!-- CA1716: 'ReadOnly' is a VB.NET keyword; suppressed intentionally - this is a C# library and the name is by design. -->
    <NoWarn>$(NoWarn);CA1716</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Core\GrznarAi.Trading.ReadOnly.csproj" />
  </ItemGroup>

</Project>

