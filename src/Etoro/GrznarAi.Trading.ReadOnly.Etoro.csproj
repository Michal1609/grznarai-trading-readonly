<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>GrznarAi.Trading.ReadOnly.Etoro</AssemblyName>
    <RootNamespace>GrznarAi.Trading.ReadOnly.Etoro</RootNamespace>
    <PackageId>GrznarAi.Trading.ReadOnly.Etoro</PackageId>
    <Title>GrznarAi Trading ReadOnly Client</Title>
    <!-- Package id matches the namespace. -->
    <!-- Strong-naming: intentionally unsigned. Enterprise consumers requiring strong names should pin to a fork. -->
    <Description>Read-only typed .NET client for trading platform public APIs, currently targeting the eToro public API. Not affiliated with eToro. Provided AS IS, without warranty or liability. No financial advice.</Description>
    <PackageTags>trading;readonly;api;client;dotnet;etoro</PackageTags>
    <PackageReadmeFile>README.nuget.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <VersionPrefix>1.0.0</VersionPrefix>
    <VersionSuffix>alpha.4</VersionSuffix>
    <PackageReleaseNotes>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\..\CHANGELOG.md'))</PackageReleaseNotes>
    <EnablePackageValidation>true</EnablePackageValidation>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
    <!-- CA1716: 'ReadOnly' is a VB.NET keyword; suppressed intentionally — this is a C# library and the name is by design. -->
    <NoWarn>$(NoWarn);CA1716</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\GrznarAi.Trading.ReadOnly.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.7" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.8" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.203" PrivateAssets="All" />
    <PackageReference Include="System.Threading.RateLimiting" Version="10.0.7" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.nuget.md" Pack="true" PackagePath="README.nuget.md" />
    <None Include="..\..\assets\nuget\MG mark.png" Pack="true" PackagePath="icon.png" />
  </ItemGroup>

</Project>
